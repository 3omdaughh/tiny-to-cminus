
C-MINUS COMPILATION: tests/valid/precedence.cm
   1: /* operator precedence and associativity */
   2: void main(void)
	2: reserved word: void
	2: ID, name= main
	2: (
	2: reserved word: void
	2: )
   3: { int a; int b; int c;
	3: {
	3: reserved word: int
	3: ID, name= a
	3: ;
	3: reserved word: int
	3: ID, name= b
	3: ;
	3: reserved word: int
	3: ID, name= c
	3: ;
   4:   a = b = c;          /* right assoc: a = (b = c)     */
	4: ID, name= a
	4: =
	4: ID, name= b
	4: =
	4: ID, name= c
	4: ;
   5:   a = a - b - c;      /* left assoc:  (a - b) - c     */
	5: ID, name= a
	5: =
	5: ID, name= a
	5: -
	5: ID, name= b
	5: -
	5: ID, name= c
	5: ;
   6:   a = a + b * c;      /* * before +:  a + (b * c)     */
	6: ID, name= a
	6: =
	6: ID, name= a
	6: +
	6: ID, name= b
	6: *
	6: ID, name= c
	6: ;
   7:   a = (a + b) * c;    /* parentheses override         */
	7: ID, name= a
	7: =
	7: (
	7: ID, name= a
	7: +
	7: ID, name= b
	7: )
	7: *
	7: ID, name= c
	7: ;
   8:   a = a + 1 < b * 2;  /* relop lowest: (a+1) < (b*2)  */
	8: ID, name= a
	8: =
	8: ID, name= a
	8: +
	8: NUM, val= 1
	8: <
	8: ID, name= b
	8: *
	8: NUM, val= 2
	8: ;
   9: }
	9: }
	10: EOF
exit=0
