
C-MINUS COMPILATION: tests/scanner/valid/whitespace.cm
   1: /* white space: blanks, tabs, blank lines, CRLF */
   2: 	int		x ;
	2: reserved word: int
	2: ID, name= x
	2: ;
   3: 
   4: 
   5:    int    y;
	5: reserved word: int
	5: ID, name= y
	5: ;
   6: x=y;x	=	y  ;
	6: ID, name= x
	6: =
	6: ID, name= y
	6: ;
	6: ID, name= x
	6: =
	6: ID, name= y
	6: ;
	7: EOF
exit=0
